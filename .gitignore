# Public source/document/evidence allowlist; keep local execution and notes.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/crucible.toml
!/crucible.lock
!/rtl/
!/tests/
!/constraints/
!/docs/
!/evidence/
!/scripts/
/scripts/*
!/scripts/run.sh
!/scripts/synthesis.ys
!/scripts/models.py
!/scripts/provenance.py
!/scripts/bitstream.py
!/scripts/mutate_configuration.py
!/scripts/verify.py
!/scripts/preflight_git.py
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/*.token
**/.unlazy/
**/.claude/
**/.codex/
**/AGENTS.md
**/SKILL.md
**/GATES.md
**/WORKLOG.md
